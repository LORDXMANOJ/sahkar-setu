# Public URL of the deployed site. Used in QR codes, so they never depend on the request's Host header.
NEXT_PUBLIC_SITE_URL=https://sahkar-setu.example.in

# AI for Sahayak (career assistant) and translation. Tried in this order; each fails over to the next.
# Without any key, Sahayak answers from a built-in guide and only English, Hindi and Tamil are available.
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Ed25519 private key that signs certificates: a PKCS#8 PEM, base64-encoded on one line.
# Generate one with:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey}=generateKeyPairSync('ed25519');console.log(Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
PASSPORT_SIGNING_KEY=


# Protects maintenance actions such as /api/lang/<code>?repair=<token>. Any long random string.
ADMIN_TOKEN=
